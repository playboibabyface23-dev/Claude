# PennyRun monitor configuration.
# Copy to .env and export the values into your shell (the monitor reads the
# real environment; it does not parse .env itself). CLI flags override these.

# Path to the leads JSON exported from the field app.
PENNYRUN_LEADS_FILE=./leads.json

# Days without contact before an active lead is flagged stale.
PENNYRUN_STALE_DAYS=7

# Warn about auction dates within this many days.
PENNYRUN_AUCTION_WINDOW=14

# Percentage used by the MAO formula (70% rule). 0.70 = 70%.
PENNYRUN_MAO_PERCENT=0.70
