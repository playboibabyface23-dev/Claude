# PennyRun provider configuration. Copy to .env and export into your shell
# (the monitor reads the real environment; it does not parse .env itself).
# Never commit .env or keys.

# Which provider sweeps use: serpapi | unwrangle | mock.
# Overrides `provider` in monitor/config.json. Mock needs no keys.
PENNYRUN_PROVIDER=mock

# https://serpapi.com — Home Depot engines; also powers `resolve`.
SERPAPI_API_KEY=

# https://unwrangle.com — Home Depot detail API.
UNWRANGLE_API_KEY=
