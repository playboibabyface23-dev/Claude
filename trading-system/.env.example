# --- Claude API (reasoning layer) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Market data providers (fill in the ones you use) ---
POLYGON_API_KEY=
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
FINNHUB_API_KEY=

# Alpaca trading host used for the position/equity query.
# true  -> https://paper-api.alpaca.markets
# false -> https://api.alpaca.markets  (real money)
ALPACA_PAPER=true

# --- Execution ---
TRADERSPOST_WEBHOOK_URL=https://webhooks.traderspost.io/trading/webhook/...

# --- Account / risk limits (hard caps, enforced in code) ---
ACCOUNT_EQUITY=25000
MAX_RISK_PER_TRADE_PCT=1.0
MAX_DAILY_LOSS_PCT=3.0
MAX_OPEN_POSITIONS=2
MIN_RISK_REWARD=1.5
MIN_PROBABILITY=0.55

# --- Quote policy (spread / slippage checks) ---
# Spread cap as a percent of entry price.
MAX_SPREAD_PCT=0.05
# Block the trade when no usable bid/ask is available. Set false only if your
# data provider cannot supply quotes (e.g. Finnhub) and you accept trading
# without spread and slippage protection.
REQUIRE_QUOTE=true
# A quote older than this is treated as no quote at all.
MAX_QUOTE_AGE_SECONDS=60
