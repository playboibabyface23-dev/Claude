# =============================================================================
# Futures Trading Agent — environment configuration
# Copy to .env and fill in. Never commit the real .env file.
# =============================================================================

# --- Claude API (decision engine) ---
ANTHROPIC_API_KEY=sk-ant-...
# Primary model for market analysis. Server-side fallback model is used
# automatically if the primary model refuses (see ai/engine.py).
CLAUDE_MODEL=claude-fable-5
CLAUDE_FALLBACK_MODEL=claude-opus-4-8
# Minimum AI confidence (0-100) required before a decision is even considered.
# Decisions below this are rejected before they reach the risk manager.
MIN_AI_CONFIDENCE=65

# --- Tradovate (market data — and execution, only if EXECUTION_MODE=tradovate) ---
# Required for live market data regardless of EXECUTION_MODE: main.py builds
# a TradovateLiveFeed automatically whenever these are configured, since
# TradersPost has no market data of its own (see EXECUTION_MODE below).
# Tradovate has separate demo and live environments with different base URLs
# and different credentials. ALWAYS start on demo.
TRADOVATE_ENV=demo
TRADOVATE_USERNAME=
TRADOVATE_PASSWORD=
# App credentials issued by Tradovate for API access (Application Settings).
TRADOVATE_APP_ID=
TRADOVATE_APP_VERSION=1.0
TRADOVATE_CID=
TRADOVATE_SEC=
TRADOVATE_DEVICE_ID=

# --- TradersPost (webhook execution — e.g. routing orders to a prop-firm
# account like Lucid that isn't directly reachable over the Tradovate REST
# API) ---
TRADERSPOST_WEBHOOK_URL=

# Which execution path places orders: "tradovate" (direct broker API) or
# "traderspost" (webhook relay, e.g. for a Lucid/prop-firm account). Only one
# order path is ever active. Market data comes from Tradovate either way —
# this only controls where orders go.
EXECUTION_MODE=traderspost

# --- Market settings ---
# Comma-separated futures symbols this agent is allowed to trade.
TRADED_SYMBOLS=MNQ,NQ,MES,ES,GC
# Candle timeframe in minutes used for indicators and AI analysis.
TIMEFRAME_MINUTES=5
# How often the main loop polls for new candles/decisions, in seconds.
POLL_INTERVAL_SECONDS=30
# Fallback market data feed, only used when Tradovate credentials above are
# NOT configured: a {symbol}-templated CSV path (e.g. data/{symbol}_bars.csv),
# polled fresh each cycle. Once Tradovate credentials are set, the live
# TradovateLiveFeed (market/tradovate_ws.py) takes over automatically and
# this is ignored -- see that module's docstring for exactly what has and
# hasn't been confirmed against a real Tradovate demo account.
HISTORICAL_BARS_CSV_TEMPLATE=

# --- Account / risk limits (hard caps, enforced in code — never by the AI) ---
# This is the LEGACY single-account configuration: used as the agent's one
# "default" trading account whenever no ACCOUNT_1_*, ACCOUNT_2_*, ... vars
# below are set. If you only trade one account, ignore the multi-account
# section entirely and just fill in these fields as before.
ACCOUNT_EQUITY=50000
RISK_PCT_PER_TRADE=0.5
MAX_DAILY_LOSS_PCT=3.0
MAX_TRADES_PER_DAY=6
MAX_DRAWDOWN_PCT=8.0
MAX_OPEN_POSITIONS=1

# --- Multi-account trading (optional) ---
# Trade N broker accounts at once from one process: one shared market-data
# feed and one shared Claude decision per symbol per cycle, fanned out to
# every account below, each independently risk-gated, sized, and executed
# (its own RiskManager, its own ExecutionEngine, its own broker client(s),
# its own optional Lucid eval guard, its own kill-switch file). Claude never
# sees or picks an account -- only a symbol.
#
# To use it: set ACCOUNT_1_*, ACCOUNT_2_*, ... (any subset of the fields
# below, per index -- unset fields fall back to that field's own default,
# e.g. RISK_PCT_PER_TRADE=0.5). Indexes can be sparse (ACCOUNT_1_ and
# ACCOUNT_3_ without ACCOUNT_2_ still both get picked up). Up to 20 accounts.
# Leave every ACCOUNT_N_* var unset (the default) to keep the single legacy
# account above -- existing .env files need no changes.
#
# ACCOUNT_1_NAME=prop_eval
# ACCOUNT_1_EXECUTION_MODE=traderspost
# ACCOUNT_1_TRADERSPOST_WEBHOOK_URL=
# ACCOUNT_1_ACCOUNT_EQUITY=50000
# ACCOUNT_1_RISK_PCT_PER_TRADE=0.5
# ACCOUNT_1_MAX_DAILY_LOSS_PCT=3.0
# ACCOUNT_1_MAX_TRADES_PER_DAY=6
# ACCOUNT_1_MAX_DRAWDOWN_PCT=8.0
# ACCOUNT_1_MAX_OPEN_POSITIONS=1
# ACCOUNT_1_MIN_AI_CONFIDENCE=65
# ACCOUNT_1_LUCID_EVAL_ENABLED=true
# ACCOUNT_1_LUCID_STARTING_BALANCE=50000
# ACCOUNT_1_LUCID_TRAILING_DRAWDOWN_AMOUNT=2000
# ACCOUNT_1_LUCID_PROFIT_TARGET=3000
# ACCOUNT_1_LUCID_MAX_CONSISTENCY_PCT=30
# ACCOUNT_1_LUCID_MIN_TRADING_DAYS=0
#
# ACCOUNT_2_NAME=live_direct
# ACCOUNT_2_EXECUTION_MODE=tradovate
# ACCOUNT_2_TRADOVATE_ENV=demo
# ACCOUNT_2_TRADOVATE_USERNAME=
# ACCOUNT_2_TRADOVATE_PASSWORD=
# ACCOUNT_2_TRADOVATE_APP_ID=
# ACCOUNT_2_TRADOVATE_APP_VERSION=1.0
# ACCOUNT_2_TRADOVATE_CID=
# ACCOUNT_2_TRADOVATE_SEC=
# ACCOUNT_2_TRADOVATE_DEVICE_ID=
# ACCOUNT_2_ACCOUNT_EQUITY=150000
# ACCOUNT_2_RISK_PCT_PER_TRADE=0.5

# Kill switch: if this file exists, the agent refuses to place any new order
# regardless of what the AI or risk manager say. Created by
# powershell/emergency_stop.ps1; delete it (or set false below) to resume.
KILL_SWITCH_FILE=logs/KILL_SWITCH
# Also trips automatically (and writes the kill switch file) when
# MAX_DAILY_LOSS_PCT or MAX_DRAWDOWN_PCT is breached.

# --- Lucid (or Lucid-shaped) prop-firm evaluation guard ---
# Off by default. Enable only when routing orders into a prop-firm eval
# account whose survival depends on EOD trailing drawdown + a consistency
# rule that the generic risk limits above know nothing about. See
# risk/lucid_eval.py's module docstring: the trailing-drawdown amount below
# is derived from a real LucidFlex 50K EVAL account summary (MLL $48,000 on
# a $50,000 balance), but the consistency percentage is an UNCONFIRMED
# placeholder -- verify against Lucid's actual published rules before this
# is trusted with a real evaluation fee.
LUCID_EVAL_ENABLED=false
LUCID_STARTING_BALANCE=50000
LUCID_TRAILING_DRAWDOWN_AMOUNT=2000
LUCID_PROFIT_TARGET=3000
LUCID_MAX_CONSISTENCY_PCT=30
LUCID_MIN_TRADING_DAYS=0

# --- Alerts ---
# Generic webhook for kill-switch trips, execution failures, and crashes --
# posts a {"text": ...} JSON body, the format Slack's and Discord's
# incoming webhooks both accept directly. Leave blank to only log locally
# (logs/, no external notification). This is what actually makes an
# unattended 24/7 run safe to walk away from -- without it, a tripped kill
# switch or a crashed process is silent until someone happens to check.
ALERT_WEBHOOK_URL=

# --- Database ---
DATABASE_PATH=database/futures_agent.db

# --- Dashboard ---
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8788

# --- Logging ---
LOG_DIR=logs
LOG_LEVEL=INFO
